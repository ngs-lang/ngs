type MultiHash(HashLike)

section "MultiHash" {
	doc Values are processed with ensure(v, Arr)
	F init(mh:MultiHash, h:Hash=null) {
		super(mh)
		mh.update(h or {})
	}

	doc Pairs [k, v] grouped by k
	F init(mh:MultiHash, pairs:Arr) super(mh, pairs.validate('pairs', Repeat([Any, Any])).group(X[0], X[1]))

	doc Throws unless v is Arr
	doc Empty Arr is allowed
	doc %RET - v
	F .=(mh:MultiHash, k, v) super(mh, k, v.validate('v', Arr))

	doc Throws unless v is Arr
	doc Empty Arr is allowed
	doc %RET - v
	F '[]='(mh:MultiHash, k, v) super(mh, k, v.validate('v', Arr))

	doc Set a key if it's not already set
	doc Throws unless v is Arr
	doc %RET - Key value, the already-existed or new.
	F dflt(mh:MultiHash, k, v) super(mh, k, F(k) Value(v, k).validate('v', Arr))

	doc Get values by key or set k to [] if it does not exist
	doc %RET - Arr
	F get(mh:MultiHash, k) mh.dflt(k, [])

	doc Append v to the values of k
	doc %RET - mh
	F push(mh:MultiHash, k, v) mh::{ A.dflt(k, []).push(v) }

	doc Replace the values of each key of src with ensure(v, Arr)
	doc %RET - mh
	F update(mh:MultiHash, src:Hash) mh::{ src.each(F(k, v) A[k] = ensure(v, Arr)) }

	TEST MultiHash([["a", "1"], ["b", "2"], ["a", "3"]]) =~ {"a": ["1", "3"], "b": ["2"]}
	TEST MultiHash().dflt("a", F(k) [k]) == ["a"]
	TEST mh = MultiHash(); mh.get("a").push("1"); mh.Hash() == {"a": ["1"]}
	TEST MultiHash({"a": ["1", "2"], "b": "3"}).update({"a": "4", "c": ["5"]}).Hash() == {"a": ["4"], "b": ["3"], "c": ["5"]}
}
